### register
POST http://localhost:8086/api/v1/auth/register
Content-Type: application/json
Accept: application/json

{
  "email": "test@mail.com",
  "password": "1234567789Test#"
}

### authenticate
POST http://localhost:8086/api/v1/auth/authenticate
Content-Type: application/json
Accept: application/json

{
  "email": "test@mail.com",
  "password": "1234567789Test#"
}

### refresh token
POST http://localhost:8086/api/v1/auth/refresh-token
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "MTliYzA5ZmItYjMwMC00ZDhiLTlmYTUtODg4YTAwMjhkZDk4"
}

### refresh token cookie
POST http://localhost:8086/api/v1/auth/refresh-token-cookie
Cookie: refresh-jwt-cookie=MTliYzA5ZmItYjMwMC00ZDhiLTlmYTUtODg4YTAwMjhkZDk4

### info
GET http://localhost:8086/api/v1/auth/info
Content-Type: application/json
Accept: application/json

{
  "email": "test@mail.com",
  "password": "1234567789Test#"
}

### logout
POST http://localhost:8086/api/v1/auth/logout
Cookie: refresh-jwt-cookie=MTliYzA5ZmItYjMwMC00ZDhiLTlmYTUtODg4YTAwMjhkZDk4
